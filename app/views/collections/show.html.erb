<% content_for :title, "#{@collection.name} · Study Carrel" %>
<main class="page">
  <div class="page-bar">
    <% if @collection.parent %>
      <%= link_to "← #{@collection.parent.name}", collection_path(@collection.parent), class: "chip" %>
    <% else %>
      <%= link_to "← Library", library_path, class: "chip" %>
    <% end %>
    <%= link_to "Continue reading", root_path, class: "chip" %>
    <%= link_to "Random", random_collection_path(@collection.slug), class: "chip" %>
  </div>
  <h2 class="page-title"><%= @collection.name %></h2>
  <% if @collection.description.present? %><p class="page-lede"><%= @collection.description %></p><% end %>

  <%= render partial: "collections/row", collection: @children, as: :collection %>

  <div class="works">
    <% @works.each do |work| %>
      <%= link_to work_path(work), class: "work-link" do %>
        <span class="work-link-title"><%= work.title %></span>
        <span class="work-link-meta"><%= work.edition.presence || pluralize(work.sections.size, "section") %></span>
      <% end %>
    <% end %>
  </div>
</main>

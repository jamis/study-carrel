<% content_for :title, "#{@collection.name} · Study Carrel" %>
<%= render "shared/header", crumbs: library_crumbs(@collection), random: RandomScope.chain_for(@collection), focus: Current.focus %>
<main class="page">
  <h2 class="page-title"><%= @collection.name %></h2>
  <% if @collection.description.present? %><p class="page-lede"><%= @collection.description %></p><% end %>
  <%= render "shared/search_form", place: @collection %>

  <%= render partial: "collections/row", collection: @children, as: :collection, locals: { work_counts: @work_counts } %>

  <div class="works">
    <% @works.each do |work| %>
      <%= link_to work_path(work), class: "work-link" do %>
        <span class="work-link-title"><%= work.title %></span>
        <span class="work-link-meta"><%= [ work.byline, work.edition ].compact_blank.join(" · ").presence || pluralize(work.sections.size, "section") %></span>
      <% end %>
    <% end %>
  </div>
</main>

<div class="list-row">
  <div class="list-row-title<%= " as-work" if collection.single_work? %>"><%= link_to collection.name, collection_path(collection) %></div>
  <% if collection.description.present? %><div class="list-row-desc"><%= collection.description %></div><% end %>
  <% if !collection.single_work? %><div class="list-row-meta"><%= pluralize(work_counts.fetch(collection.id), "work") %></div><% end %>
</div>

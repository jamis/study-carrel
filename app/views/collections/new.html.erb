<% content_for :title, "New collection · Study Carrel" %>
<%= render "shared/rail", focus: Current.focus %>
<main class="page">
  <%= page_head [ [ "Library", library_path ], [ "Your Texts", texts_path ], [ "New collection", new_collection_path ] ] %>
  <%= form_with model: @collection, class: "collection-form" do |form| %>
    <% if @collection.errors.any? %><p class="signin-alert" role="alert"><%= @collection.errors.full_messages.to_sentence %>.</p><% end %>
    <%= form.text_field :name, class: "shelf-name-input", placeholder: "Name this collection", required: true, maxlength: 200,
          autocomplete: "off", autofocus: true, aria: { label: "Collection name" } %>
    <%= form.text_field :description, class: "shelf-desc-input", placeholder: "A line about it (optional)", maxlength: 300,
          autocomplete: "off", aria: { label: "A line about it" } %>
    <p class="collection-form-lede">Gather texts that belong together, like the books of one scripture or a year of journals. It starts empty: add texts into it. Only you can see it.</p>
    <label class="one-work">
      <%= form.check_box :single_work %>
      <span><b>One work in parts</b>
        <span>Like the Bible: its texts are books of a single work, and Random picks evenly from all their passages rather than giving each text an equal chance.</span></span>
    </label>
    <div class="texts-actions">
      <%= form.submit "Make the collection", class: "primary" %>
      <%= link_to "Cancel", texts_path, class: "chip" %>
    </div>
  <% end %>
</main>

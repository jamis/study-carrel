<%# Recent places: the clock button and its dropdown (history_controller.js). In the top bar and the reader's rail. %>
<div class="history" data-controller="menu history" data-history-url-value="<%= history_path %>"
     data-action="keydown.esc@window->menu#escape click@window->menu#away keydown@window->history#key click@window->history#fromMenu">
  <button class="icon-btn history-btn" type="button" title="Recent places (h)" aria-label="Recent places" aria-expanded="false" aria-controls="history-panel"
          data-menu-target="button" data-history-target="button" data-action="menu#toggle history#refresh"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></button>
  <div class="history-panel" id="history-panel" data-menu-target="panel" data-history-target="panel" data-action="keydown->history#arrow">
    <div class="hist-head">Recent places</div>
    <div data-history-target="list"></div>
  </div>
</div>

<%# One row of a sheet page (a focus's notes, the Kept page): the passage at left, its note level with it on the sheet
    at right.
    citation, passage, content: the reference, the passage's text (nil for a note on the focus as a whole, which has no
      passage), the note (or kept remark; may be nil)
    href: where the passage is read; the whole passage cell links there (nil for a detached note, whose passage is gone)
    actions: buttons under the note
    labels: the note's label names, quietly under it (a detached note's are kept as text)
    detached: the detached note, which says why it was set aside and can be discarded %>
<% detached = local_assigns[:detached]
   href = local_assigns[:href]
   actions = local_assigns[:actions]
   passage = local_assigns[:passage]
   long = passage.to_s.length > 300 || passage.to_s.count("\n") > 3 %>
<div class="nb-passage<%= " nb-linked" if href %><%= " nb-detached" if detached %>" <%= tag.attributes(id: (dom_id(detached) if detached), data: ({ controller: "expand" } if long)) %>>
  <div class="nb-ref-row">
    <% if href %>
      <%= link_to citation, href, class: "nb-ref" %>
      <span class="nb-open" aria-hidden="true">Open<svg viewBox="0 0 24 24"><path d="M4 5.5C4 4.7 4.7 4 5.5 4H11v16H5.5c-.8 0-1.5-.7-1.5-1.5z"/><path d="M13 4h5.5c.8 0 1.5.7 1.5 1.5V11"/><path d="M13 20v-9"/><path d="m16 15 3 3-3 3"/><path d="M13 18h6"/></svg></span>
    <% else %>
      <span class="nb-ref"><%= citation %></span>
    <% end %>
  </div>
  <% if detached %><p class="nb-why">set aside <%= l detached.created_at.to_date, format: :long %>, when <%= detached.why %></p><% end %>
  <% if passage %><p class="nb-quote<%= " clamped" if long %>" data-expand-target="text"><%= passage %></p><% end %>
  <% if long %>
    <button class="nb-more" type="button" data-action="expand#toggle" data-expand-target="button" aria-expanded="false">Show full passage</button>
  <% end %>
</div>
<div class="nb-note">
  <%= content %>
  <% if (labels = local_assigns[:labels].presence || detached&.label_names.presence) %>
    <p class="nb-labels"><%= labels.join(" · ") %></p>
  <% end %>
  <% if actions || detached %>
    <div class="nb-note-actions">
      <%= actions %>
      <% if detached %>
        <%= button_to "Discard", detached_note_path(detached), method: :delete, class: "chip", form_class: "inline-form",
              data: { turbo_confirm: "Discard this #{detached.kept? ? "remark" : "note"}? It can’t be brought back." } %>
      <% end %>
    </div>
  <% end %>
</div>

<%# The top bar shared by the reading view and the library pages.
    crumbs: [[label, path, tooltip], ...], last one is the current page
    focus: the current focus (for the All notes link; nil if none)
    band: show the focus band under the nav
    random: where the Random item goes (scoped on collection and work pages) %>
<% focus = local_assigns[:focus]
   band = local_assigns[:band] && focus
   reading = local_assigns[:band]
   random = local_assigns[:random] || random_path %>
<header class="top" data-controller="theme">
  <div class="nav">
    <div class="nav-in">
      <nav class="crumbs" aria-label="Breadcrumb" data-controller="crumbs">
        <ol>
          <% crumbs.each_with_index do |(label, path, title), i| %>
            <% last = i == crumbs.size - 1 %>
            <% if i == 1 %><li class="crumb-more" hidden aria-hidden="true">…</li><% end %>
            <%= tag.li class: ("crumb-last" if last), data: { crumbs_target: "item" } do %><%= link_to label, path, class: "crumb", title: title, aria: { current: ("page" if last) } %><% end %>
          <% end %>
        </ol>
      </nav>
      <div class="history" data-controller="menu history" data-history-url-value="<%= history_path %>"
           data-action="keydown.esc@window->menu#escape click@window->menu#away keydown@window->history#key click@window->history#fromMenu">
        <button class="icon-btn history-btn" type="button" title="Recent places (h)" aria-label="Recent places" aria-expanded="false" aria-controls="history-panel"
                data-menu-target="button" data-history-target="button" data-action="menu#toggle history#refresh"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></button>
        <div class="history-panel" id="history-panel" data-menu-target="panel" data-history-target="panel" data-action="keydown->history#arrow">
          <div class="hist-head">Recent places</div>
          <div data-history-target="list"></div>
        </div>
      </div>
      <div class="menu" data-controller="menu" data-action="keydown.esc@window->menu#escape click@window->menu#away">
        <button class="icon-btn menu-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu"
                data-menu-target="button" data-action="menu#toggle">⋯</button>
        <div class="menu-panel" id="nav-menu" data-menu-target="panel">
          <%= render "notes/all_link", focus: focus if focus %>
          <%= link_to "All focuses", foci_path, class: "menu-item" %>
          <button class="menu-item menu-history" type="button" data-history-open data-action="menu#close">Recent places<kbd>h</kbd></button>
          <% unless reading %><%= link_to "Continue reading", root_path, class: "menu-item" %><% end %>
          <%= link_to "Random", random, class: "menu-item" %>
          <%= link_to "Kept", kept_path, class: "menu-item" %>
          <button class="menu-item" type="button" data-action="theme#toggle">Light / dark</button>
          <% if Current.user.admin? %><%= link_to "Invitations", admin_invitations_path, class: "menu-item" %><% end %>
          <%= button_to "Sign out", session_path, method: :delete, class: "menu-item", form_class: "signout" %>
        </div>
      </div>
    </div>
  </div>
  <%= render "foci/band", focus: focus if band %>
</header>

<%# The top bar of the library pages (the reading view has its own rail, readings/_rail).
    crumbs: [[label, path, tooltip], ...], last one is the current page
    focus: the current focus (for the All notes link; nil if none)
    random: the RandomScope places Random can roll in, innermost first (just the library if omitted)
    random_default: the one the Random item rolls in (the first if omitted) %>
<% focus = local_assigns[:focus]
   random = local_assigns[:random] || [ RandomScope.library ]
   random_default = local_assigns[:random_default] || random.first %>
<header class="top" data-controller="theme">
  <div class="nav">
    <div class="nav-in">
      <nav class="crumbs" aria-label="Breadcrumb" data-controller="crumbs">
        <ol>
          <% crumbs.each_with_index do |(label, path, title), i| %>
            <% last = i == crumbs.size - 1 %>
            <% if i == 1 %><li class="crumb-more" hidden aria-hidden="true">…</li><% end %>
            <%= tag.li class: ("crumb-last" if last), data: { crumbs_target: "item" } do %><%= link_to label, path, class: "crumb", title: title, aria: { current: ("page" if last) } %><% end %>
          <% end %>
        </ol>
      </nav>
      <%= render "shared/history" %>
      <div class="menu" data-controller="menu" data-action="keydown.esc@window->menu#escape click@window->menu#away">
        <button class="icon-btn menu-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu"
                data-menu-target="button" data-action="menu#toggle">⋯</button>
        <div class="menu-panel" id="nav-menu" data-menu-target="panel">
          <%= render "shared/menu_items", focus: focus, reading: false, random: random, random_default: random_default %>
        </div>
      </div>
    </div>
  </div>
</header>

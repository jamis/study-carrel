<% content_for :title, "#{@work.name} · Study Carrel" %>
<% numbered = @sections.all?(&:numbered?) %>
<%= render "shared/header", crumbs: library_crumbs(@work.collection, work: @work), random: RandomScope.chain_for(@work), focus: Current.focus %>
<main class="page">
  <h2 class="page-title"><%= @work.title %></h2>
  <p class="page-lede"><%= [ @work.byline, @work.edition, pluralize(@sections.size, "section") ].compact_blank.join(" · ") %></p>

  <% if numbered %>
    <nav class="strip chapters" aria-label="Chapters">
      <% @sections.each do |section| %>
        <%= link_to section.number, reading_path(@work.slug, section.number, @first_unit_numbers[section.id]),
              class: "tick#{" has" if @noted_section_ids.include?(section.id)}",
              aria: { label: "#{section.name}#{", has notes" if @noted_section_ids.include?(section.id)}" } %>
      <% end %>
    </nav>
  <% else %>
    <ol class="section-list">
      <% @sections.each do |section| %>
        <li>
          <%= link_to section.label.presence || section.number, reading_path(@work.slug, section.number, @first_unit_numbers[section.id]) %>
          <% if @noted_section_ids.include?(section.id) %><span class="noted-dot" title="Has notes"></span><% end %>
        </li>
      <% end %>
    </ol>
  <% end %>
</main>

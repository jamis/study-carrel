<% content_for :title, "Notes · #{@focus.title} · Study Carrel" %>
<%# One focus's notes, the current focus's or a past one's (the rail is still the current focus's). Laid out as in the
    reader: the passages down the left under the focus, the notes on a sheet down the right, each level with its
    passage. The passage side is the way back into reading. %>
<%= render "shared/rail", focus: Current.focus %>
<main class="page notes-page">
  <%= page_head [ [ "Your focuses", foci_path ], [ "Notes", focus_notes_path(@focus) ] ] do %>
    <% if @notes.any? || @free.any? || @detached.any? %>
      <span class="page-actions" data-controller="clipboard" data-clipboard-url-value="<%= export_focus_notes_path(@focus) %>">
        <% if @notes.any? || @free.any? %>
          <%= link_to focus_reread_path(@focus), class: "chip", title: "Reread these notes one at a time (r)",
                data: { controller: "key-link", key_link_key_value: "r", action: "keydown@window->key-link#key" } do %>Reread<% end %>
        <% end %>
        <button class="chip" type="button" data-action="clipboard#copy" data-clipboard-target="button">Copy<span class="wide-only"> Markdown</span></button>
        <%= link_to safe_join(["Download", tag.span(" .md", class: "wide-only")]), export_focus_notes_path(@focus), class: "chip", data: { turbo: false } %>
      </span>
    <% end %>
  <% end %>

  <% none = @notes.empty? && @free.empty? && @detached.empty? %>
  <div class="nb-sheet<%= " nb-empty" if none %>">
    <header class="nb-focus">
      <div class="nb-focus-head"><%= render "foci/mark" %><h1 class="nb-focus-title"><%= @focus.title %></h1></div>
      <% if @focus.description.present? %><p class="nb-focus-desc"><%= @focus.description %></p><% end %>
    </header>
    <p class="nb-lede"><%= pluralize(@notes.size, "note") %>, in reading order<% if @free.any? %>, and <%= @free.size %> on the whole<% end %><% if @focus.archived? %> · <%= focus_span(@focus) %><% end %></p>

    <% if none %>
      <p class="page-empty">No notes yet. Open a verse and write what it says to your question.</p>
    <% end %>

    <% @notes.each do |note|
      unit = note.unit %>
      <%= render "shared/sheet_row", citation: unit_ref(unit.section, unit), passage: unit.body, content: note.content, labels: note.labels.map(&:name).sort_by(&:downcase),
            href: reading_path(unit.section.work.slug, unit.section.number, unit.number) %>
    <% end %>

    <% if @free.any? %>
      <h2 class="nb-detached-head">On the whole focus</h2>
      <% @free.each do |note| %>
        <%= render "shared/sheet_row", citation: "Written #{l note.created_at.to_date, format: :long}", content: note.content,
              labels: note.labels.map(&:name).sort_by(&:downcase) %>
      <% end %>
    <% end %>

    <% if @detached.any? %>
      <h2 class="nb-detached-head">From passages that changed or were removed</h2>
      <% @detached.each do |detached| %>
        <%= render "shared/sheet_row", citation: detached.citation, passage: detached.passage, content: detached.content, detached: detached %>
      <% end %>
    <% end %>
  </div>
</main>

<% content_for :title, "Notes · #{@focus.title} · Study Carrel" %>
<%# A focus's notes page (the current focus's or a past one's), where they're reread: those on passages in reading
    order down the column, then those on the focus as a whole, the one you're on lit and the rest dimmed in place, each
    note's labels as pills under it, each rereading only its label's notes (?label=, with a band over the run saying so;
    there Remove takes the label off the note you're on). The focus's scratchpad is put away behind a tab at the right edge (a bottom sheet on
    phones); the labels in use, as a cloud or as tallies, come up over its foot, or on their own. Notes on the whole
    focus can be written and edited here, and so can the current focus's notes on passages, as in the reader.
    "Gather" (g) turns the column into a comparison: up to three notes held under tabs on a card at
    the top, the rest under it, each to put in one of the held note's groups (labels, named or not) or a new group with
    it. Detached notes, whose passages are gone, follow the run, only to read or discard.
    An archived focus's page is read-only: its notes, labels and scratchpad to read, nothing to write, label or
    gather, and Unarchive in the lede. %>
<% archived = @focus.archived? %>
<main class="reader reread" data-controller="reread<%= " compare peek" unless archived %>"
      data-reread-position-url-value="<%= focus_reread_path(@focus) %>"
      data-reread-read-only-value="<%= archived %>"
      data-reread-filter-value="<%= @label&.id %>"
      <% if @label %>data-reread-rename-url-value="<%= focus_label_path(@focus, @label) %>"<% end %>
      data-reread-labels-url-template-value="<%= focus_note_labels_path(@focus, "{id}") %>"
      data-reread-lift-url-value="<%= focus_notes_path(@focus) %>"
      data-compare-labels-url-template-value="<%= focus_note_labels_path(@focus, "{id}") %>"
      data-compare-rename-url-template-value="<%= focus_label_path(@focus, "{id}") %>"
      data-action="<%= "keydown@document->peek#key keydown@document->compare#key " unless archived %>keydown@document->reread#key mouseover->reread#light click@document->reread#away note:saved@window->reread#saved selectionchange@document->reread#selected">
  <%= render "shared/rail", focus: Current.focus, here: (:notes if @focus == Current.focus) %>

  <div class="reader-col reread-col">
    <%= page_head [ [ "Your focuses", foci_path ], *([ [ "Archived", archived_foci_path ] ] if archived), [ "Notes" ] ] do %>
      <span class="page-actions" data-controller="clipboard" data-clipboard-url-value="<%= export_focus_notes_path(@focus) %>">
        <% unless archived %>
          <%= link_to safe_join(["Edit", tag.span(" focus", class: "wide-only")]), edit_focus_path(@focus, back: "notes"), class: "chip" %>
        <% end %>
        <% if @all.any? || @detached&.any? %>
          <button class="chip" type="button" data-action="clipboard#copy" data-clipboard-target="button">Copy<span class="wide-only"> Markdown</span></button>
          <%= link_to safe_join(["Download", tag.span(" .md", class: "wide-only")]), export_focus_notes_path(@focus), class: "chip", data: { turbo: false } %>
        <% end %>
      </span>
    <% end %>
    <header class="rr-focus">
      <div class="nb-focus-head"><%= render "foci/mark" %><h1 class="nb-focus-title"><%= @focus.title %></h1></div>
    </header>

    <div class="rr-lede">
      <span class="menu" data-controller="menu" data-action="keydown.esc@window->menu#escape click@window->menu#away">
        Rereading
        <button class="rr-filter<%= " on" if @label %>" type="button" title="Reread only the notes with one label" aria-expanded="false" data-menu-target="button" data-action="menu#toggle"><% if @label %>the <span data-reread-target="count"><%= pluralize(@notes.size, "note") %></span> <%= label_phrase_tag(@label) %><% else %><%= pluralize(@notes.size, "note") %><% end %> <span class="rr-caret" aria-hidden="true">▾</span></button>
        <%= render "rereads/filter_menu", focus: @focus, notes: @all %>
      </span>
      <% if archived %>
        <span class="rr-archived">· Archived <%= l @focus.archived_at.to_date, format: :long %> ·
          <%= button_to "Unarchive", unarchive_focus_path(@focus, back: "notes"), method: :patch, form_class: "inline-form" %></span>
        <span class="rr-keys">· <kbd>j</kbd>/<kbd>k</kbd> to move, <kbd>c</kbd> for the labels, <kbd>s</kbd> the scratchpad</span>
      <% else %>
        <span class="rr-keys">· <kbd>j</kbd>/<kbd>k</kbd> to move, <kbd>l</kbd> to label, <kbd>g</kbd> to gather, <kbd>c</kbd> for the labels,<% if @label %> <kbd>r</kbd> to name this one,<% end %> <kbd>n</kbd> for a new note, <kbd>s</kbd> the scratchpad</span>
      <% end %>
    </div>
    <%# Rereading one label: saying so over the run, with Rename (r) and the way back to them all (×, or Esc). Not
        prefetched, as pills aren't (rereads/_note_labels). %>
    <% if @label %>
      <div class="rr-filter-band" data-reread-target="band">
        <span class="rr-filter-what">Only the <span data-reread-target="count"><%= pluralize(@notes.size, "note") %></span> <%= label_phrase_tag(@label) %><span data-reread-target="removed" hidden> · 1 just removed</span></span>
        <%= render "rereads/filter_naming", label: @label, focus: @focus unless archived %>
        <%= link_to "Show all #{@all.size}", focus_notes_path(@focus, at: @here&.id), class: "rr-filter-all", data: { action: "reread#unfilter", turbo_prefetch: false } %>
        <%= link_to "×", focus_notes_path(@focus, at: @here&.id), class: "rr-filter-x", title: "Show all the notes (Esc)", aria: { label: "Show all the notes" }, data: { action: "reread#unfilter", turbo_prefetch: false } %>
      </div>
    <% end %>
    <% unless archived %>
    <p class="rr-lede rr-cmp-lede">Gathering what goes with the note you're on<span class="rr-keys"> · <kbd>j</kbd>/<kbd>k</kbd> through the others, <kbd>1</kbd>–<kbd>9</kbd> or <kbd>+</kbd> to group, <kbd>Enter</kbd> to hold one under a tab, <kbd>[</kbd>/<kbd>]</kbd> from tab to tab, <kbd>x</kbd> to let one go, <kbd>p</kbd>/<kbd>o</kbd> the whole passage or note (<kbd>P</kbd> a row's passage), <kbd>g</kbd> or × to go back</span></p>

    <%# Gathering what goes with a note: the notes held under tabs at the top of the column, the one you're on with its
        groups numbered for the moment. Drawn from the rows by the compare controller. %>
    <section class="rr-cmp-card" aria-label="The notes you're holding" data-compare-target="card" hidden></section>
    <% end %>

    <% if @label %>
      <p class="page-empty" data-reread-target="empty" <%= "hidden" if @notes.any? %>>No notes here are <%= label_phrase_tag(@label) %> any more.</p>
    <% elsif @notes.empty? %>
      <p class="page-empty"><%= archived ? "No notes." : "No notes yet. Open a verse and write what it says to your question." %></p>
    <% end %>

    <div class="rr-run">
      <% passage_notes, free_notes = @notes.partition(&:unit_id) %>
      <% passage_notes.each do |note| %>
        <%= render "rereads/row", note:, focus: @focus, here: note == @here %>
      <% end %>
      <%# Notes on the focus as a whole: what you see across the passages, written here or made of a line in the
          scratchpad. New ones join the end. %>
      <section class="rr-free-notes" id="reread_free" aria-label="On the whole focus">
        <h2 class="rr-free-head">On the whole focus</h2>
        <% free_notes.each do |note| %>
          <%= render "rereads/row", note:, focus: @focus, here: note == @here %>
        <% end %>
      </section>
      <% unless @label || archived %>
        <button class="rr-new" type="button" data-action="reread#newNote" title="A note on the focus as a whole (n)">+ New note</button>
      <% end %>
      <%# A new note on the whole focus, before its first save makes it (removed again if you move on with it empty). %>
      <% unless archived %>
      <template data-reread-target="newRow">
        <article class="rr-row rr-free rr-unsaved" data-reread-target="row" data-editor-url="<%= new_focus_note_path(@focus) %>" data-action="click->reread#pick">
          <div class="rr-head"><span class="rr-ref rr-whole">New note</span></div>
          <div class="rr-text"><div class="rr-note"></div></div>
          <div class="rr-editor composer"></div>
          <div class="rr-labels" id="new_note_labels" data-label-ids=""></div>
        </article>
      </template>
      <% end %>

      <%# Notes set aside when their passages changed or went: no longer notes to label or group, only to read or
          discard. Out of the run. %>
      <% if @detached&.any? %>
        <section class="rr-detached" aria-label="From passages that changed or were removed">
          <h2 class="rr-free-head">From passages that changed or were removed</h2>
          <% @detached.each do |detached| %>
            <article class="rr-gone" id="<%= dom_id(detached) %>">
              <div class="rr-head"><span class="rr-ref rr-whole"><%= detached.citation %></span></div>
              <p class="rr-why">set aside <%= l detached.created_at.to_date, format: :long %>, when <%= detached.why %></p>
              <% if detached.passage.present? %><p class="rr-passage"><%= detached.passage %></p><% end %>
              <div class="rr-note"><%= detached.content %></div>
              <div class="rr-labels">
                <% detached.label_names.to_a.each do |name| %><span class="rr-chip"><%= name %></span><% end %>
                <% unless archived %>
                  <%= button_to "Discard", detached_note_path(detached), method: :delete, class: "chip", form_class: "inline-form rr-discard",
                        data: { turbo_confirm: "Discard this note? It can’t be brought back." } %>
                <% end %>
              </div>
            </article>
          <% end %>
        </section>
      <% end %>
    </div>

    <%# The label picker, by the + label of the note you're on: all your labels as a cloud, A–Z or most recently used
        first, narrowed as you type. The footer says what Enter does: the closest match, or a new label of what you
        typed when nothing matches. %>
    <div class="rr-picker" data-reread-target="picker" hidden>
      <div class="rr-picker-head">
        <input type="text" maxlength="40" placeholder="Label this note" autocomplete="off" aria-label="Label" data-reread-target="pickerInput"
               data-action="input->reread#filterPicker keydown->reread#pickerKey">
        <span class="rr-picker-sort">
          <button type="button" data-sort="alpha" data-action="reread#sortPicker">A–Z</button> · <button type="button" data-sort="recent" data-action="reread#sortPicker">Recent</button>
        </span>
      </div>
      <div class="rr-picker-cloud" role="listbox" data-reread-target="pickerOptions"></div>
      <div class="rr-picker-foot" data-reread-target="pickerFoot"></div>
    </div>
    <p class="rr-toast" role="status" data-reread-target="toast" hidden></p>
    <%# What a reference on the Gather card opens: its note. %>
    <% unless archived %><div class="fn-pop" data-peek-target="pop" hidden></div><% end %>
    <%= form_with url: focus_note_labels_path(@focus, 0), method: :post, class: "rr-label-form", data: { reread_target: "labelForm" } do %>
      <input type="hidden" name="name">
    <% end %>
  </div>

  <aside class="panel reread-pad" data-controller="sheet" data-reread-target="pad"
         data-action="keydown.esc@window->sheet#escape scratchpad:text@window->sheet#preview">
    <button class="panel-handle" type="button" aria-expanded="false" data-sheet-target="handle" data-action="sheet#toggle">
      <span class="panel-label">Scratchpad</span>
      <% pad_text = @focus.scratchpad&.to_plain_text.to_s.squish.truncate(200) %>
      <span class="preview<%= " empty" if pad_text.blank? %>" data-sheet-target="preview"><%= pad_text.presence || "Half-thoughts, questions, things to compare…" %></span>
      <span class="go" data-sheet-target="label" aria-hidden="true">▴</span>
    </button>
    <%# On phones, a new note on the whole focus and the labels are on the scratchpad's handle. %>
    <span class="rr-pad-tools rr-pad-tools-phone">
      <% unless @label || archived %><button class="rr-summon rr-new-phone" type="button" data-action="reread#newNote">New note</button><% end %>
      <button class="rr-summon" type="button" aria-expanded="false" data-action="reread#toggleLabels">Labels</button>
    </span>
    <%# Elsewhere, the scratchpad and the labels are each behind a tab at the right edge, which slides them in. %>
    <span class="rr-edge">
      <button class="rr-edge-tab" type="button" title="The scratchpad (s)" data-action="sheet#toggle">Scratchpad<kbd>s</kbd></button>
      <button class="rr-edge-tab rr-summon" type="button" title="The labels on this focus (c)" aria-expanded="false" data-action="reread#toggleLabels">Labels<kbd>c</kbd></button>
    </span>
    <div class="panel-head rr-pad-head">
      <span class="panel-label">Scratchpad</span>
      <button class="rr-close" type="button" aria-label="Put the scratchpad away" title="Put it away (Esc)" data-action="sheet#toggle">×</button>
    </div>
    <% if archived %>
      <div class="rr-pad-read"><%= @focus.scratchpad.presence || tag.p("Nothing in the scratchpad.", class: "empty") %></div>
    <% else %>
    <%# Select some of the scratchpad and this turns it into a note on the whole focus. %>
    <button class="rr-lift" type="button" data-reread-target="lift" data-action="mousedown->reread#keepSelection click->reread#lift" hidden>Make a note of this</button>
    <div class="composer">
      <%= form_with model: @focus, url: focus_scratchpad_path(@focus), method: :put,
            data: { controller: "autosave", autosave_focus_id_value: @focus.id, autosave_param_value: "scratchpad", action: "submit->autosave#prevent" } do |form| %>
        <%= form.rich_textarea :scratchpad, preset: "notes", rows: 8, placeholder: "Half-thoughts, questions, things to compare…",
              aria: { label: "Scratchpad" },
              data: { autosave_target: "editor", action: "lexxy:initialize->autosave#ready lexxy:change->autosave#changed lexxy:blur->autosave#save" } %>
        <p class="autosave-status" aria-live="polite" data-autosave-target="status">&nbsp;</p>
      <% end %>
    </div>
    <% end %>

    <%# The labels in use, called up over the foot of the scratchpad (Labels, or c) and put away again (×, Esc, c). %>
    <section class="rr-labels-panel" aria-label="Labels" data-reread-target="labelsPanel">
      <div class="rr-labels-head">
        <span class="panel-label">Labels on this focus</span>
        <span class="rr-views">
          <button type="button" data-view="cloud" data-action="reread#view">Cloud</button><button type="button" data-view="tallies" data-action="reread#view">Tallies</button>
        </span>
        <button class="rr-close" type="button" aria-label="Put the labels away" data-action="reread#toggleLabels">×</button>
      </div>
      <div class="rr-labels-body" id="reread_labels"><%= render "rereads/labels", focus: @focus, notes: @all %></div>
      <p class="rr-labels-hint">Point at a label to light its notes<%= "; tap it to put the note you're on on it, or take it off" unless archived %>.</p>
    </section>
  </aside>
  <%= render "foci/toast", back: "notes" %>
</main>

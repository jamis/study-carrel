<% content_for :title, "Notes · #{@focus.title} · Study Carrel" %>
<%# One focus's notes, the current focus's or a past one's (the rail is still the current focus's). %>
<%= render "shared/rail", focus: Current.focus %>
<main class="page">
  <%= page_head [ [ "Your focuses", foci_path ], [ "Notes", focus_notes_path(@focus) ] ] do %>
    <% if @notes.any? || @detached.any? %>
      <span class="page-actions" data-controller="clipboard" data-clipboard-url-value="<%= export_focus_notes_path(@focus) %>">
        <button class="chip" type="button" data-action="clipboard#copy" data-clipboard-target="button">Copy<span class="wide-only"> Markdown</span></button>
        <%= link_to safe_join(["Download", tag.span(" .md", class: "wide-only")]), export_focus_notes_path(@focus), class: "chip", data: { turbo: false } %>
      </span>
    <% end %>
  <% end %>
  <h2 class="page-title all-notes-title"><%= @focus.title %></h2>
  <p class="page-lede"><%= pluralize(@notes.size, "note") %>, in reading order<% if @focus.archived? %> · <%= focus_span(@focus) %><% end %></p>

  <% if @notes.empty? && @detached.empty? %>
    <p class="page-empty">No notes yet. Open a verse and write what it says to your question.</p>
  <% end %>

  <% @notes.each do |note|
    unit = note.unit %>
    <% long = unit.body.length > 300 %>
    <section class="fv-item" <%= tag.attributes(data: { controller: "expand" }) if long %>>
      <%= link_to unit_ref(unit.section, unit), reading_path(unit.section.work.slug, unit.section.number, unit.number), class: "fv-ref" %>
      <p class="fv-quote<%= " clamped" if long %>" data-expand-target="text"><%= unit.body %></p>
      <% if long %>
        <button class="fv-more" type="button" data-action="expand#toggle" data-expand-target="button" aria-expanded="false">Show full passage</button>
      <% end %>
      <div class="fv-note"><%= note.content %></div>
    </section>
  <% end %>

  <%= render "detached_notes/list", detached_notes: @detached %>
</main>

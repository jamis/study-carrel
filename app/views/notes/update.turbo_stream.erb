<%# On the reread page, the note's text in its row, for when the editor moves on (empty if it was cleared). %>
<%= turbo_stream.update dom_id(@note, :reread_text) do %><%= @note.content if @note.persisted? %><% end %>
<%= turbo_stream.replace "focus_notes_link", partial: "notes/menu_link", locals: { focus: @focus } if @focus == Current.focus %>

<div class="note" id="<%= dom_id(note) %>">
  <div class="note-meta">
    <span><%= time_ago_in_words(note.created_at) %> ago</span>
    <span><%= button_to "Delete", note_path(note), method: :delete, form_class: "inline-form",
          form: { data: { turbo_confirm: "Delete this note?" } } %></span>
  </div>
  <%= note.content %>
</div>

<%= turbo_frame_tag note, class: "note" do %>
  <div class="note-meta">
    <span><%= time_ago_in_words(note.created_at) %> ago</span>
    <span class="note-actions">
      <%= link_to "Edit", edit_note_path(note) %>
      <%= button_to "Delete", note_path(note), method: :delete, form_class: "inline-form",
            form: { data: { turbo_confirm: "Delete this note?" } } %>
    </span>
  </div>
  <%= note.content %>
<% end %>

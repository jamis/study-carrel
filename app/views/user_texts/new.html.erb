<% revising = @work.present? %>
<% content_for :title, "#{revising ? "Revise #{@work.title}" : "Add a text"} · Study Carrel" %>
<%= render "shared/header", crumbs: user_text_crumbs(@work), focus: Current.focus %>
<main class="texts-page">
  <% if revising %>
    <h2 class="page-title">Revise “<%= @work.title %>”</h2>
    <% unit = @text.poetry? ? "stanza" : "sentence" %>
    <p class="texts-lede">Edit it freely. Notes and kept passages on unchanged <%= unit.pluralize %> stay put; anything on a <%= unit %> that’s gone is set aside with its passage, never lost. The review shows exactly what moves before you save.</p>
  <% else %>
    <h2 class="page-title">Add a text</h2>
    <p class="texts-lede">A journal, the transcript of a talk, poems, song lyrics. Only you can see texts you add.</p>
  <% end %>

  <div class="texts-source">
    <%= form_with model: @text, url: (revising ? review_text_path(@work) : review_texts_path), multipart: true, class: "texts-form",
          data: { turbo: false, controller: "text-source", action: "dragover->text-source#over dragleave->text-source#leave drop->text-source#drop" } do |f| %>
      <% if @text.errors.any? %>
        <p class="signin-alert" role="alert"><%= @text.errors.full_messages.map { it.sub(/\ASource /, "The text ") }.to_sentence %>.</p>
      <% end %>
      <label class="texts-field"><span>Title</span><%= f.text_field :title, autocomplete: "off", required: true, autofocus: @text.title.blank?, data: { text_source_target: "title" } %></label>
      <label class="texts-field"><span>Author <small>optional</small></span><%= f.text_field :author, autocomplete: "off" %></label>
      <fieldset class="texts-form-choice">
        <legend>Read it as<% if revising %> <small>(a revision keeps its form)</small><% end %></legend>
        <label><%= f.radio_button :form, "prose", disabled: revising, data: { text_source_target: "prose", action: "text-source#count" } %><span><b>Prose</b><span>A sentence at a time, like Walden</span></span></label>
        <label><%= f.radio_button :form, "poetry", disabled: revising, data: { text_source_target: "poetry", action: "text-source#count" } %><span><b>Poetry or lyrics</b><span>A stanza at a time, line breaks kept</span></span></label>
      </fieldset>
      <p class="texts-verse-hint" data-text-source-target="hint" hidden>This looks like verse. <button type="button" class="texts-linkish" data-action="text-source#poetry">Read it as poetry</button></p>
      <div class="texts-field">
        <div class="texts-src-head">
          <label for="user_text_source">Text</label>
          <button type="button" class="texts-linkish" data-action="text-source#choose">Choose a file…</button>
          <input type="file" accept=".txt,.md,.markdown,text/plain,text/markdown" hidden data-text-source-target="file" data-action="text-source#pick">
        </div>
        <%= f.text_area :source, spellcheck: false, required: true, placeholder: "Paste the text here, or drop a .txt or .md file on this box.",
              data: { text_source_target: "source", action: "input->text-source#count" } %>
        <div class="texts-src-foot"><span data-text-source-target="stats"></span><span class="texts-error" data-text-source-target="error" role="status"></span></div>
      </div>
      <div class="texts-actions">
        <%= f.submit "Review", class: "primary", name: nil %>
        <%= link_to "Cancel", (revising ? work_path(@work) : texts_path), class: "chip" %>
      </div>
    <% end %>

    <aside class="texts-howto" aria-labelledby="howto-head">
      <h3 id="howto-head">How the text is read</h3>
      <div class="texts-howto-prose">
      <ol>
        <li><b>Paragraphs.</b> Blank lines between paragraphs, and line breaks inside one are joined. With no blank lines at all, every line is a paragraph.</li>
        <li><b>Sections.</b> A line starting <code>#&nbsp;</code> starts a section, named by the rest of the line. No headings: one section.</li>
        <li><b>Sentences.</b> Each paragraph is read a sentence at a time, like Walden.</li>
        <li><b>A backslash</b> beside <code>.</code> <code>?</code> <code>!</code> decides a split: <code>Sgt\. Pepper</code> isn’t an ending, <code>with M.\ We</code> is. <code>\\</code> is a backslash.</li>
        <li><b>Everything else</b> shows exactly as typed. Asterisks stay asterisks.</li>
      </ol>
      <pre># 3 March 2024

Woke before six. The house
was quiet.

Read Isaiah 40 again.</pre>
      </div>
      <div class="texts-howto-poetry">
      <ol>
        <li><b>Stanzas.</b> Blank lines separate stanzas, and every line break is kept. With no blank lines, a poem is one stanza.</li>
        <li><b>Sections.</b> A line starting <code>#&nbsp;</code> starts a section (a poem, or a song), named by the rest of the line. No headings: one section.</li>
        <li><b>A stanza at a time,</b> like Frost.</li>
        <li><b>Labels</b> like <code>[Chorus]</code> are read as typed; the review points them out. Indents are lost.</li>
        <li><b>Everything else</b> shows exactly as typed. Asterisks stay asterisks.</li>
      </ol>
      <pre># Low Water

The river’s down to stones again,
the dock leans like a tired man.

So I’ll wait by the low water,
wait till the low water’s gone.</pre>
      </div>
    </aside>
  </div>
</main>

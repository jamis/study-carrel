<% content_for :title, "Your Texts · Study Carrel" %>
<% place = OwnTexts.new(Current.user) %>
<%= render "shared/header", crumbs: [ [ "Library", library_path ], [ "Your Texts", texts_path ] ], random: RandomScope.chain_for(place), focus: Current.focus %>
<main class="page">
  <h2 class="page-title">Your Texts</h2>
  <p class="page-lede">Journals, talks, anything in prose you’ve added. Only you can see them. <%= link_to "Add a text", new_text_path %></p>
  <%= render "shared/search_form", place: place if @texts.any? %>
  <% if flash[:alert] || flash[:notice] %><p class="<%= flash[:alert] ? "signin-alert" : "signin-notice" %>" role="status"><%= flash[:alert] || flash[:notice] %></p><% end %>

  <% if @texts.empty? %>
    <p class="page-empty">Nothing here yet. <%= link_to "Add a text", new_text_path %> to read it a sentence at a time, with your focus beside it.</p>
  <% end %>
  <% @texts.each do |work| %>
    <div class="list-row texts-row-item">
      <div class="list-row-title as-work"><%= link_to work.title, work_path(work) %></div>
      <div class="list-row-meta">
        <%= [ work.author, pluralize(@sentence_counts.fetch(work.id, 0), "sentence"), "added #{l work.created_at.to_date, format: :long}" ].compact.join(" · ") %>
        <%= link_to "Revise", edit_text_path(work), class: "texts-action" %>
        <% attached = @annotation_counts.fetch(work.id, 0) %>
        <%= button_to "Delete", text_path(work), method: :delete, class: "texts-delete", form_class: "inline-form",
              form: { data: { turbo_confirm: "Delete “#{work.title}”? This can’t be undone.#{" Its #{pluralize(attached, "note or kept passage", plural: "notes and kept passages")} will be set aside with the passages they were written on." if attached.positive?}" } } %>
      </div>
    </div>
  <% end %>
</main>

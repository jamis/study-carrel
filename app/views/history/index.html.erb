<% if @visits.empty? %>
  <p class="hist-empty">The places you read will appear here.</p>
<% else %>
  <% @visits.each do |visit| %>
    <% unit = visit.unit %>
    <%= link_to reading_path(unit.section.work.slug, unit.section.number, unit.number), class: "hist-item" do %>
      <span class="hist-ref"><%= unit.reference %><% if @kept_unit_ids.include?(unit.id) %><i class="hist-kept" title="Kept" aria-label="kept"></i><% end %><% if @noted_unit_ids.include?(unit.id) %><i class="hist-note" title="Has a note" aria-label="has a note"></i><% end %></span>
      <span class="hist-when"><%= time_ago_in_words(visit.visited_at) %> ago</span>
      <span class="hist-text"><%= truncate(unit.body, length: 90, separator: " ") %></span>
    <% end %>
  <% end %>
<% end %>

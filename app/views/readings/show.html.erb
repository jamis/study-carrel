<% content_for :title, "#{@section.name} · Study Carrel" %>
<% note_text = @notes_by_unit[@current.id]&.content&.to_plain_text.to_s.squish.truncate(200) %>
<main class="reader" data-controller="lectio"
      data-lectio-current-value="<%= @current.number %>"
      data-lectio-position-url-value="<%= position_path %>"
      data-lectio-note-url-template-value="<%= unit_note_path("{id}") %>"
      data-action="note:saved@window->lectio#noteSaved keep:changed@window->lectio#keepChanged"
      data-lectio-base-value="<%= reading_path(@section.work.slug, @section.number) %>"
      data-lectio-ref-template-value="<%= @section.reference_template %>"
      data-lectio-ref-unit-template-value="<%= @section.reference_unit_template %>"
      data-lectio-unit-name-value="<%= unit_noun(@section) %>"
      data-lectio-group-name-value="<%= @section.work.group_name %>"
      data-lectio-prev-url-value="<%= edge_url(@previous_section, :previous) %>"
      data-lectio-prev-label-value="<%= @previous_section&.name %>"
      data-lectio-next-url-value="<%= edge_url(@next_section, :next) %>"
      data-lectio-next-label-value="<%= @next_section&.name %>">
  <%= render "readings/rail", section: @section, previous_section: @previous_section, next_section: @next_section, focus: @focus,
             random: RandomScope.chain_for(@section.work), random_default: RandomScope.default_for(@section.work) %>

  <div hidden>
    <% @units.each do |u| %>
      <span data-lectio-target="unit" data-number="<%= u.number %>" data-label="<%= u.label %>" data-paragraph="<%= u.paragraph %>" data-opens="<%= u.sentence == 1 %>" data-unit-id="<%= u.id %>" data-size="<%= unit_size_class(u.body) %>"><%= u.body %></span>
    <% end %>
  </div>

  <% at = @units.index(@current) %>
  <% prev_unit = (@units[at - 1] if at.positive?) %>
  <% next_unit = @units[at + 1] %>
  <div class="reader-col">
    <div class="reader-top" data-reader-top><%= render "foci/band", focus: @focus %></div>
    <article class="lectio" data-action="touchstart->lectio#touchStart touchend->lectio#touchEnd keydown@document->lectio#key">
      <div class="now <%= unit_size_class(@current.body) %>" aria-live="polite" data-lectio-target="now"><div class="now-head"><%= render "keeps/ribbon", unit: @current, kept: @kept %><span class="ref" title="<%= unit_ref(@section, @current) %>" data-lectio-target="ref"><%= unit_ref_parts(@section, @current) %></span></div><span class="pilcrow" aria-hidden="true" data-lectio-target="pilcrow" <%= "hidden" unless @current.sentence == 1 %>>¶</span><span data-lectio-target="body"><%= @current.body %></span></div>

      <%# ‹ 25 of 31 ›: the number opens a grid of every verse (a dot = has a note, a ribbon = kept). Past either end, the arrows carry on into the next chapter.
          Prose is read a sentence at a time: its grid has a row per paragraph, and ¶ shows the whole paragraph. %>
      <nav class="steps" aria-label="<%= unit_noun(@section).pluralize %>">
        <% prev_label = prev_unit ? "#{unit_noun(@section)} #{prev_unit.label}" : @previous_section&.name %>
        <% next_label = next_unit ? "#{unit_noun(@section)} #{next_unit.label}" : @next_section&.name %>
        <button class="step" type="button" title="<%= prev_label %>" aria-label="<%= prev_label %>" data-lectio-target="prevButton" data-action="lectio#previous" <%= "hidden" unless prev_label %>>‹</button>
        <div class="steps-menu" data-controller="menu" data-action="keydown.esc@window->menu#escape click@window->menu#away">
          <button class="step step-of" type="button" title="Go to a <%= unit_noun(@section).downcase %>" aria-expanded="false" aria-controls="unit-grid"
                  data-menu-target="button" data-action="menu#toggle lectio#gridOpened"><span data-lectio-target="position"><%= @current.number %></span> of <%= @units.last.number %></button>
          <div class="unit-grid<%= " by-group" if @section.work.sentences? %>" id="unit-grid" data-menu-target="panel" data-lectio-target="grid">
            <% @units.chunk_while { |a, b| a.paragraph && a.paragraph == b.paragraph }.each do |group| %>
              <% if group.first.paragraph %><div class="grid-group"><span class="grid-group-name">¶ <%= group.first.paragraph %></span><span class="grid-group-cells"><% end %>
              <% group.each do |u| %>
                <% noted = @notes_by_unit.key?(u.id) %>
                <% kept = @kept.key?(u.id) %>
                <button type="button" class="cell<%= " current" if u == @current %><%= " has" if noted %><%= " kept" if kept %>" aria-current="<%= u == @current %>" tabindex="<%= u == @current ? 0 : -1 %>" data-lectio-target="tick" data-number="<%= u.number %>" data-action="lectio#go menu#close" aria-label="<%= unit_noun(@section) %> <%= u.label %><%= ", has a note" if noted %><%= ", kept" if kept %>"><%= u.sentence || u.number %></button>
              <% end %>
              <% if group.first.paragraph %></span></div><% end %>
            <% end %>
          </div>
        </div>
        <button class="step" type="button" title="<%= next_label %>" aria-label="<%= next_label %>" data-lectio-target="nextButton" data-action="lectio#next" <%= "hidden" unless next_label %>>›</button>
        <% if @section.work.sentences? %>
          <% group = @section.work.group_name || "paragraph" %>
          <div class="steps-menu" data-controller="menu" data-action="keydown.esc@window->menu#escape click@window->menu#away">
            <button class="step step-whole" type="button" title="The whole <%= group %> (p)" aria-label="The whole <%= group %>" aria-expanded="false" aria-controls="whole-group"
                    data-menu-target="button" data-lectio-target="wholeButton" data-action="menu#toggle lectio#wholeOpened">¶</button>
            <div class="whole-group" id="whole-group" data-menu-target="panel" data-lectio-target="whole"></div>
          </div>
        <% end %>
      </nav>
    </article>
  </div>

  <aside class="panel" data-controller="sheet" data-action="keydown.esc@window->sheet#escape note:text@window->sheet#preview">
    <button class="panel-handle" type="button" aria-expanded="false" data-sheet-target="handle" data-action="sheet#toggle">
      <span class="panel-label">Note</span>
      <span class="ref" title="<%= unit_ref(@section, @current) %>" data-lectio-target="ref"><%= unit_ref_parts(@section, @current) %></span>
      <span class="preview<%= " empty" if note_text.blank? %>" data-sheet-target="preview"><%= note_text.presence || "Write a note" %></span>
      <span class="go" data-sheet-target="label" aria-hidden="true">▴</span>
    </button>
    <div class="panel-head">
      <span class="panel-label">Note</span>
      <span class="ref" title="<%= unit_ref(@section, @current) %>" data-lectio-target="ref"><%= unit_ref_parts(@section, @current) %></span>
    </div>
    <div class="composer">
      <%= render "unit_notes/editor", unit: @current, note: @notes_by_unit[@current.id], focus: @focus %>
    </div>
  </aside>
</main>

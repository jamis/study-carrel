<% content_for :title, "#{@section.name} · Study Carrel" %>
<header class="top" data-controller="theme">
  <div class="nav">
    <div class="nav-in">
      <%= link_to "Study Carrel", library_path, class: "brand", title: "Library" %>
      <%= link_to work_path(@section.work), class: "where", title: "#{@section.name}: chapters in #{@section.work.title}", data: { controller: "fit" } do %><%= @section.name %><small><%= [ @section.work.short_byline, @section.work.edition ].compact_blank.join(" · ") %></small><% end %>
      <%= render "notes/all_link", focus: @focus %>
      <div class="menu" data-controller="menu" data-action="keydown.esc@window->menu#escape click@window->menu#away">
        <button class="icon-btn menu-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu"
                data-menu-target="button" data-action="menu#toggle">⋯</button>
        <div class="menu-panel" id="nav-menu" data-menu-target="panel">
          <%= link_to "Library", library_path, class: "menu-item menu-library" %>
          <%= link_to "Random", random_path, class: "menu-item chip" %>
          <button class="menu-item icon-btn" type="button" title="Toggle light / dark" aria-label="Toggle light / dark" data-action="theme#toggle"><span aria-hidden="true">◐</span><span class="menu-label">Light / dark</span></button>
          <% if Current.user.admin? %><%= link_to "Invitations", admin_invitations_path, class: "menu-item chip" %><% end %>
          <%= button_to "Sign out", session_path, method: :delete, class: "menu-item chip", form_class: "signout" %>
        </div>
      </div>
    </div>
  </div>
  <%= render "foci/band", focus: @focus %>
</header>

<main class="layout" data-controller="lectio"
      data-lectio-current-value="<%= @current.number %>"
      data-lectio-position-url-value="<%= position_path %>"
      data-lectio-note-url-template-value="<%= unit_note_path("{id}") %>"
      data-action="note:saved@window->lectio#noteSaved"
      data-lectio-base-value="<%= reading_path(@section.work.slug, @section.number) %>"
      data-lectio-ref-template-value="<%= @section.reference_template %>"
      data-lectio-ref-unit-template-value="<%= @section.reference_unit_template %>"
      data-lectio-unit-name-value="<%= unit_noun(@section) %>"
      data-lectio-prev-url-value="<%= edge_url(@previous_section, :previous) %>"
      data-lectio-prev-label-value="<%= @previous_section&.name %>"
      data-lectio-next-url-value="<%= edge_url(@next_section, :next) %>"
      data-lectio-next-label-value="<%= @next_section&.name %>">
  <div hidden>
    <% @units.each do |u| %>
      <span data-lectio-target="unit" data-number="<%= u.number %>" data-unit-id="<%= u.id %>"><%= u.body %></span>
    <% end %>
  </div>

  <% at = @units.index(@current) %>
  <% prev_unit = (@units[at - 1] if at.positive?) %>
  <% next_unit = @units[at + 1] %>
  <article class="lectio" data-action="touchstart->lectio#touchStart touchend->lectio#touchEnd keydown@document->lectio#key">
    <div class="near<%= " edge" if !prev_unit && @previous_section %>" aria-hidden="true" data-lectio-target="prev" data-action="click->lectio#previous"><% if prev_unit %><b><%= prev_unit.number %></b><%= prev_unit.body %><% elsif @previous_section %><b>←</b><%= @previous_section.name %><% end %></div>
    <div class="now <%= unit_size_class(@current.body) %>" aria-live="polite" data-lectio-target="now"><span class="ref" title="<%= unit_ref(@section, @current) %>" data-lectio-target="ref"><%= unit_ref_parts(@section, @current) %></span><span data-lectio-target="body"><%= @current.body %></span></div>
    <div class="near<%= " edge" if !next_unit && @next_section %>" aria-hidden="true" data-lectio-target="next" data-action="click->lectio#next"><% if next_unit %><b><%= next_unit.number %></b><%= next_unit.body %><% elsif @next_section %><b>→</b><%= @next_section.name %><% end %></div>
    <div class="steps">
      <button class="chip" type="button" data-action="lectio#previous">← Previous</button>
      <button class="chip" type="button" data-action="lectio#next">Next →</button>
    </div>
    <nav class="strip<%= " scrolling" if @units.size > 40 %>" aria-label="<%= unit_noun(@section).pluralize %>" data-lectio-target="strip">
      <% @units.each do |u| %>
        <% noted = @notes_by_unit.key?(u.id) %>
        <button type="button" class="tick<%= " current" if u == @current %><%= " has" if noted %>" aria-current="<%= u == @current %>" tabindex="<%= u == @current ? 0 : -1 %>" data-lectio-target="tick" data-number="<%= u.number %>" data-action="lectio#go" aria-label="<%= unit_noun(@section) %> <%= u.number %><%= ", has a note" if noted %>"><%= u.number %></button>
      <% end %>
    </nav>
  </article>

  <aside class="panel" data-controller="sheet" data-action="keydown.esc@window->sheet#escape">
    <button class="panel-handle" type="button" aria-expanded="false" data-sheet-target="handle" data-action="sheet#toggle">
      <span class="ref" title="<%= unit_ref(@section, @current) %>" data-lectio-target="ref"><%= unit_ref_parts(@section, @current) %></span>
      <span class="count" data-lectio-target="count">Notes</span>
      <span class="go" data-sheet-target="label">Notes ▴</span>
    </button>
    <div class="panel-head">
      <div class="ref" title="<%= unit_ref(@section, @current) %>" data-lectio-target="ref"><%= unit_ref_parts(@section, @current) %></div>
      <div class="pfocus"><%= @focus.title %></div>
    </div>
    <div class="composer">
      <%= render "unit_notes/editor", unit: @current, note: @notes_by_unit[@current.id] %>
    </div>
  </aside>
</main>

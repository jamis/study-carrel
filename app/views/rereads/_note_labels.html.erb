<%# A note's labels on the reread page. On the note you're on they're chips you can take off, with + label; on the rest,
    quiet names. Their ids are on the element, to light the note when its label is pointed at. %>
<div class="rr-labels" id="<%= dom_id(note, :labels) %>" data-reread-target="noteLabels" data-label-ids="<%= note.label_ids.join(" ") %>">
  <% note.labels.sort_by { it.name.downcase }.each do |label| %>
    <span class="rr-chip"><%= label.name %><button class="rr-chip-x" type="button" aria-label="Take off “<%= label.name %>”" data-label-id="<%= label.id %>" data-action="reread#unlabel">×</button></span>
  <% end %>
  <button class="rr-add" type="button" data-action="reread#openPicker" title="Label this note (l)">+ label</button>
</div>

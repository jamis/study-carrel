<%# A note's labels on the reread page. On the note you're on they're chips you can take off, with + label; on the rest,
    quiet names. An unnamed label shows as "like" another of its notes. Their ids are on the element, to light the note
    when its label is pointed at. %>
<div class="rr-labels" id="<%= dom_id(note, :labels) %>" data-reread-target="noteLabels" data-compare-target="noteLabels" data-label-ids="<%= note.label_ids.join(" ") %>">
  <% note.labels.sort_by { [ it.named? ? 0 : 1, it.name.to_s.downcase, it.id ] }.each do |label| %>
    <span class="rr-chip" title="<%= label_title(label, from: note) unless label.named? %>"><%= label_face(label, from: note) %><button class="rr-chip-x" type="button" aria-label="Take off “<%= label_title(label, from: note, snippet: false) %>”" data-label-id="<%= label.id %>" data-action="reread#unlabel">×</button></span>
  <% end %>
  <button class="rr-add" type="button" data-action="reread#openPicker" title="Label this note (l)">+ label</button>
  <button class="rr-find" type="button" data-action="compare#enter" title="Go through the other notes for those that go with this one (g)">Find what goes with this</button>
</div>

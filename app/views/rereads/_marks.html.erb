<%# A note's footnote marks, after its text: one per label it carries, numbered in the order the labels were made and in
    each label's colour. Pointing at one (or a tap) shows the label and its other notes (the footnotes controller). %>
<span class="rr-marks" id="<%= dom_id(note, :marks) %>"><% footnoted_labels(note).each_with_index do |label, i| %><button type="button" class="rr-mark" data-fn-label="<%= label.id %>" style="--c: var(--g<%= label.hue %>)" aria-label="<%= label_title(label, from: note, snippet: false) %>"><%= i + 1 %></button><% end %></span>

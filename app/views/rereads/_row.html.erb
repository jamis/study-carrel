<%# One note on the reread page. A note on a passage shows the passage and links into the reader; one on the focus as
    a whole has neither, and goes by its number ("Focus 2"). editor_url: where its
    editor loads from (the reader's, for the current focus's notes on passages; its own, for notes on the whole focus;
    none for another focus's notes on passages, or any of an archived focus's). %>
<% unit = note.unit
   editor_url = if focus.archived? then nil
                elsif note.free? then focus_note_path(focus, note)
                elsif focus == Current.focus then unit_note_path(unit)
                end %>
<article class="rr-row<%= " here" if here %><%= " rr-free" if note.free? %>" id="<%= dom_id(note, :reread) %>" data-reread-target="row"
         data-note-id="<%= note.id %>" data-cite="<%= note_ref(note) %>"
         data-editor-url="<%= editor_url %>" data-action="click->reread#pick">
  <div class="rr-head">
    <% if unit %>
      <%= link_to reading_path(unit.section.work.slug, unit.section.number, unit.number), class: "rr-ref" do %>
        <span class="rr-cite"><%= unit_ref(unit.section, unit) %></span><span class="rr-open">Open in the reader →</span>
      <% end %>
    <% else %>
      <span class="rr-ref rr-whole"><span class="rr-cite">Focus <%= note.number %></span> · <%= l note.created_at.to_date, format: :long %></span>
    <% end %>
  </div>
  <% if unit %><p class="rr-passage"><%= unit.body %></p><% end %>
  <div class="rr-text"><div class="rr-note" id="<%= dom_id(unit || note, :reread_text) %>"><%= note.content %></div></div>
  <div class="rr-editor composer"></div>
  <%= render "rereads/note_labels", note:, editable: !focus.archived? %>
</article>

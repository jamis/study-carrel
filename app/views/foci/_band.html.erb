<%# The focus, standing directly over the passage: a thought bubble in the keep ribbon's slot (so the focus lines up with
    the reference below), the focus itself and a rule across the column. With a description, a chevron at the end of
    its last line drops the description, and nothing else: editing the focus is done from the cards and its notes page.
    Without one, the focus is only read. %>
<% if focus.description.present? %>
  <section class="focus" data-controller="focus" data-action="click@document->focus#closeOutside keydown.esc@window->focus#escape">
    <button class="focus-head" type="button" aria-expanded="false" title="About this focus" data-focus-target="head" data-action="focus#toggle">
      <%= render "foci/mark" %>
      <span class="focus-line"><h1 class="focus-title"><%= focus.title %></h1><span class="focus-caret"><svg viewBox="0 0 13 8" aria-hidden="true"><path d="M1.5 1.5 6.5 6.5 11.5 1.5"/></svg></span></span>
    </button>
    <div class="focus-body"><div class="focus-body-in"><%= simple_format(h(focus.description)) %></div></div>
  </section>
<% else %>
  <section class="focus">
    <div class="focus-head">
      <%= render "foci/mark" %>
      <span class="focus-line"><h1 class="focus-title"><%= focus.title %></h1></span>
    </div>
  </section>
<% end %>

<% content_for :title, "Focuses · Study Carrel" %>
<main class="page">
  <div class="page-bar">
    <%= link_to "← Back to reading", root_path, class: "chip" %>
    <%= link_to "New focus", new_focus_path, class: "chip" %>
  </div>
  <h2 class="page-title">Focuses</h2>

  <% if @current %>
    <h3 class="page-sub">Current</h3>
    <div class="list-row">
      <%# Home resumes the current focus where it was left (or opens the library if nothing is read yet). %>
      <div class="list-row-title"><%= link_to @current.title, root_path,
            title: (@current.last_unit ? "Continue reading at #{@current.last_unit.reference}" : "Choose where to begin") %></div>
      <div class="list-row-meta">since <%= l @current.created_at.to_date, format: :long %></div>
    </div>
  <% end %>

  <h3 class="page-sub">Past</h3>
  <% if @past.empty? %>
    <p class="page-empty">Nothing here yet. Focuses you set aside will be kept here.</p>
  <% end %>
  <% @past.each do |focus| %>
    <div class="list-row">
      <div class="list-row-title"><%= focus.title %></div>
      <% if focus.description.present? %><div class="list-row-desc"><%= focus.description %></div><% end %>
      <div class="list-row-meta">
        <%= l focus.created_at.to_date, format: :long %> – <%= l focus.archived_at.to_date, format: :long %>
        · <%= button_to "Make current", restore_focus_path(focus), method: :patch, class: "chip", form_class: "inline-form" %>
      </div>
    </div>
  <% end %>
</main>

<% content_for :title, "New focus · Study Carrel" %>
<main class="signin">
  <h1 class="brand">Study Carrel</h1>
  <p class="signin-notice"><%= Current.user.foci.current_one ? "What will you ponder next?" : "What do you want to ponder as you read?" %></p>
  <%= render "form", focus: @focus, submit: "Begin" %>
  <% if Current.user.foci.exists? %>
    <p class="signin-notice">
      <% if Current.user.foci.current_one %><%= link_to "Cancel", root_path %> · <% end %><%= link_to "Past foci", foci_path %>
    </p>
  <% end %>
</main>

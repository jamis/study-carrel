<%= form_with model: focus, class: "signin-form" do |form| %>
  <% if focus.errors.any? %><p class="signin-alert">Give your focus a title.</p><% end %>
  <%= form.text_field :title, required: true, autofocus: true, placeholder: "A question, metaphor, or thesis" %>
  <%= form.text_area :description, rows: 4, placeholder: "Why this? (optional)" %>
  <%= form.submit submit, class: "primary" %>
<% end %>

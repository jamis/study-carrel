<%# The notes whose labels changed: their labels, named from the focus's notes as they now stand; the labels panel;
    and the menu of labels to reread. A label just named or renamed is also redrawn where the band and lede say it. %>
<% all = @focus.notes_for_reread %>
<% @notes.each do |note| %>
  <%= turbo_stream.replace dom_id(note, :labels), partial: "rereads/note_labels", locals: { note:, focus: @focus } %>
<% end %>
<%= turbo_stream.update "reread_labels", partial: "rereads/labels", locals: { focus: @focus, notes: all } %>
<%= turbo_stream.replace "reread_filter_menu", partial: "rereads/filter_menu", locals: { focus: @focus, notes: all } %>
<% if @renamed %>
  <%= turbo_stream.update_all ".#{dom_id(@renamed, :phrase)}", label_phrase(@renamed) %>
  <%= turbo_stream.replace dom_id(@renamed, :naming), partial: "rereads/filter_naming", locals: { label: @renamed, focus: @focus } %>
<% end %>

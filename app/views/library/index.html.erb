<% content_for :title, "Library · Study Carrel" %>
<%= render "shared/rail", focus: Current.focus, here: :library %>
<main class="page">
  <h2 class="page-title">Library</h2>
  <%= render "shared/search_form" %>

  <% if @collections.empty? && @loose_works.empty? %>
    <p class="page-empty">No texts are loaded yet. Run <code>bin/rails db:seed</code> on the server.</p>
  <% end %>

  <div class="list-row">
    <div class="list-row-title"><%= link_to "Your Texts", texts_path %></div>
    <% if @texts.any? %>
      <div class="list-row-desc">Texts you’ve uploaded, which only you can see. The latest:</div>
      <ul class="texts-latest">
        <% @texts.sort_by(&:created_at).reverse.first(5).each do |work| %><li><%= link_to work.title, work_path(work) %></li><% end %>
      </ul>
    <% else %>
      <div class="list-row-desc">Journals, talks, poems, songs: read a sentence or a stanza at a time. Only you can see them.</div>
    <% end %>
    <div class="list-row-meta"><%= [ (pluralize(@own_collections.size, "collection") if @own_collections.any?), (pluralize(@texts.size, "text") if @texts.any?) ].compact.join(" · ") %><%= link_to "Add a text", new_text_path %></div>
  </div>

  <div class="list-row">
    <div class="list-row-title">Your shelves</div>
    <% if @shelves.any? %>
      <div class="list-row-desc">Works and collections you’ve put together, to roll Random and search in. Only you can see them.</div>
      <ul class="texts-latest">
        <% @shelves.each do |shelf| %>
          <% names = shelf.members.map { shelf_thing_name(it) } %>
          <li><%= link_to shelf.name, shelf_path(shelf) %><span class="shelf-holds"><%= names.size > 3 ? "#{names.first(3).join(" · ")} and #{names.size - 3} more" : names.join(" · ").presence || "nothing yet" %></span></li>
        <% end %>
      </ul>
    <% else %>
      <div class="list-row-desc">Put works and collections together (favorite poets, one tradition’s scripture) to roll Random and search in. Only you can see them.</div>
    <% end %>
    <div class="list-row-meta"><% if @shelves.any? %><%= pluralize(@shelves.size, "shelf", plural: "shelves") %> ·<% end %><%= link_to "New shelf", new_shelf_path %></div>
  </div>

  <%= render partial: "collections/row", collection: @collections, as: :collection, locals: { work_counts: @work_counts } %>

  <% @loose_works.each do |work| %>
    <div class="list-row">
      <div class="list-row-title"><%= link_to work.name, work_path(work) %></div>
    </div>
  <% end %>
</main>

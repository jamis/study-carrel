<% content_for :title, "Kept · Study Carrel" %>
<%# Laid out as a focus's notes page: the passages down the left, each one's remark and actions on a sheet down the
    right. The passage side is the way back into reading. %>
<%= render "shared/rail", focus: Current.focus, here: :kept %>
<main class="page notes-page">
  <% if @keeps.any? %>
    <%= page_head do %>
      <span class="page-actions" aria-label="Order">
        <%= link_to "Newest", kept_path, class: "chip#{" current" unless params[:order] == "reading"}" %>
        <%= link_to "Reading order", kept_path(order: "reading"), class: "chip#{" current" if params[:order] == "reading"}" %>
      </span>
    <% end %>
  <% end %>

  <div class="nb-sheet<%= " nb-empty" if @keeps.empty? && @detached.empty? %>">
    <header class="nb-focus">
      <div class="nb-focus-head"><svg class="kept-mark" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4h10v16l-5-4-5 4z"/></svg><h1 class="nb-focus-title kept-title">Kept</h1></div>
    </header>
    <p class="nb-lede"><%= pluralize(@keeps.size, "passage") %> you wanted to come back to</p>

    <% if @keeps.empty? && @detached.empty? %>
      <p class="page-empty">Nothing kept yet. When a passage stays with you, tap the ribbon beside the text.</p>
    <% end %>

    <% @keeps.each do |keep|
      unit = keep.unit %>
      <% actions = capture do %>
        <%= link_to "Start a focus from this", new_focus_path(unit_id: unit.id), class: "chip",
              data: { turbo_confirm: ("Start a new focus? The current one will be archived; you can bring it back from All focuses." if @has_focus) } %>
        <%= button_to "Release", unit_keep_path(unit), method: :delete, class: "chip", form_class: "inline-form",
              data: { turbo_confirm: "Release this passage?" } %>
      <% end %>
      <%= render "shared/sheet_row", citation: unit.reference, passage: unit.body,
            content: (tag.p(keep.remark, class: "nb-remark") if keep.remark), actions: actions,
            href: reading_path(unit.section.work.slug, unit.section.number, unit.number) %>
    <% end %>

    <% if @detached.any? %>
      <h2 class="nb-detached-head">From passages that changed or were removed</h2>
      <% @detached.each do |detached| %>
        <%= render "shared/sheet_row", citation: detached.citation, passage: detached.passage, content: detached.content, detached: detached %>
      <% end %>
    <% end %>
  </div>
</main>

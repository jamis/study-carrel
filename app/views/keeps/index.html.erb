<% content_for :title, "Kept · Study Carrel" %>
<% turbo_refreshes_with method: :morph, scroll: :preserve # jotting, removing, or Undo, leaves you where you were %>
<%# One column, one stream, newest first, like a commonplace book: passages copied out with a line of your own, and
    ideas that are only your line, under quiet month heads. Remarks set aside when their passage changed or went
    take their place by when they were kept. %>
<%= render "shared/rail", focus: Current.focus, here: :kept %>
<main class="page kept-page">
  <header>
    <div class="kept-head"><svg class="kept-mark" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4h10v16l-5-4-5 4z"/></svg><h1 class="kept-title">Kept</h1></div>
    <% if @entries.any? %>
      <p class="kept-desc">What stayed with you, kept apart from any focus: passages you kept with the ribbon beside a passage’s reference<span class="kept-key"> (<kbd>b</kbd>)</span>, and ideas you’d like to study someday. Open a passage to read on from it, or start a focus from any of them.</p>
    <% end %>
  </header>

  <%= render "keeps/jot", url: ideas_path, method: :post, key: "n" do %>
    <button class="jot-open" type="button" data-jot-target="shown" data-action="jot#open">+ Jot an idea<kbd>n</kbd></button>
  <% end %>

  <% if @entries.empty? %>
    <p class="page-empty">Nothing kept yet. When a passage stays with you, tap the ribbon beside the text; when something comes to you that you’d like to study, jot it here.</p>
  <% end %>

  <% @entries.chunk_while { |a, b| kept_time(a).beginning_of_month == kept_time(b).beginning_of_month }.each do |month| %>
    <h2 class="kept-month"><%= l kept_time(month.first), format: "%B %Y" %></h2>
    <% month.each do |entry| %>
      <% if entry.is_a?(DetachedNote) %>
        <%= render "keeps/set_aside", detached: entry %>
      <% elsif entry.idea? %>
        <%= render "keeps/idea", idea: entry %>
      <% else %>
        <%= render "keeps/passage", keep: entry %>
      <% end %>
    <% end %>
  <% end %>

  <% if (removed = flash[:removed]) && (unit = Unit.visible_to(Current.user).find_by(id: removed["unit_id"])) %>
    <div class="focus-toast" role="status">
      <span>Removed <%= unit.reference %> from Kept</span>
      <%= button_to "Undo", unit_keep_path(unit), method: :post, form_class: "inline-form",
            params: { remark: removed["remark"], kept_at: removed["kept_at"] }.compact %>
    </div>
  <% elsif (removed = flash[:removed_idea]) %>
    <div class="focus-toast" role="status">
      <span>Removed “<%= Keep.new(remark: removed["remark"]).idea_title %>” from Kept</span>
      <%= button_to "Undo", ideas_path, method: :post, form_class: "inline-form",
            params: { keep: { remark: removed["remark"] }, kept_at: removed["kept_at"] } %>
    </div>
  <% end %>
</main>

<% content_for :title, "#{@shelf.name_was} · Study Carrel" %>
<%= render "shared/rail", random: RandomScope.chain_for(@shelf), focus: Current.focus %>
<main class="page">
  <%= page_head [ [ "Library", library_path ], [ @shelf.name_was, shelf_path(@shelf) ], [ "Edit", edit_shelf_path(@shelf) ] ] %>
  <%= render "form", shelf: @shelf %>
  <%= button_to "Delete this shelf", shelf_path(@shelf), method: :delete, class: "shelf-delete", form_class: "shelf-delete-form",
        form: { data: { turbo_confirm: "Delete “#{@shelf.name_was}”? Only the shelf goes: the works stay in the library, and your notes and keeps stay where they are." } } %>
</main>

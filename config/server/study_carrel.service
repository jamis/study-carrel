[Unit]
Description=Study Carrel (Puma)
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/study_carrel/current
Environment=RAILS_ENV=production
Environment=PORT=3000
Environment=SOLID_QUEUE_IN_PUMA=1
Environment=MALLOC_ARENA_MAX=2
Environment=PATH=/home/deploy/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/deploy/.local/share/mise/shims/bundle exec puma -C config/puma.rb
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
